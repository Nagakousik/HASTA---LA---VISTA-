# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored; never commit a real key.

# Server-side only: used by the Vite dev/preview proxy at /api/groq.
GROQ_API_KEY=

# Optional. The app defaults to qwen/qwen3.8-27b and falls back to
# llama-3.1-8b-instant automatically.
VITE_GROQ_MODEL=

# Firebase Web App configuration.
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup.
# These values identify the project and are safe to ship in the browser.
# Firestore security rules (firestore.rules) protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
